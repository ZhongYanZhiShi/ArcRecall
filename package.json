{
  "name": "arc-recall-desktop",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhongYanZhiShi/ArcRecall.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm desktop:dev",
    "dev:web": "next dev --webpack",
    "build": "next build",
    "tauri": "mise exec -- tauri",
    "desktop:dev": "mise exec -- tauri dev",
    "desktop:dev:full": "pnpm engine-bundle:prepare && mise exec -- tauri dev --config src-tauri/tauri.windows.full.conf.json",
    "desktop:build": "pnpm engine-bundle:prepare && mise exec -- tauri build --config src-tauri/tauri.windows.full.conf.json",
    "desktop:build:basic": "mise exec -- tauri build --config src-tauri/tauri.windows.basic.conf.json",
    "desktop:build:thin": "pnpm desktop:build:basic",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 --package-only",
    "engine-bundle:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-engine-bundle.ps1",
    "release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "release:local": "node ./scripts/release-local.mjs",
    "signing:remember": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/signing-password.ps1 -Action Remember",
    "signing:forget": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/signing-password.ps1 -Action Forget",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:workflows": "node scripts/desktop-smoke.mjs --workflows-only",
    "test:desktop:data": "node scripts/desktop-smoke.mjs --data-management-only",
    "test:desktop:compression": "node scripts/desktop-smoke.mjs --compression-presets-only",
    "test:desktop:batch-compression": "node scripts/desktop-smoke.mjs --batch-compression-only",
    "test:desktop:improvements": "node scripts/desktop-smoke.mjs --improvements-only",
    "test:desktop:lifecycle": "node scripts/desktop-smoke.mjs --lifecycle-only --with-retries"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.12.0 || >=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0"
}
