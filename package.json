{
  "name": "arc-recall-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhongYanZhiShi/arc-recall.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --webpack",
    "build": "next build",
    "tauri": "mise exec -- tauri",
    "desktop:dev": "mise exec -- tauri dev",
    "desktop:dev:full": "pnpm engine-bundle:prepare && mise exec -- tauri dev --config src-tauri/tauri.windows.full.conf.json",
    "desktop:build": "pnpm engine-bundle:prepare && mise exec -- tauri build --config src-tauri/tauri.windows.full.conf.json",
    "desktop:build:thin": "mise exec -- tauri build",
    "engine-bundle:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-engine-bundle.ps1",
    "lint": "eslint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.52.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
